# The look dataset
SOURCE_PROJECT=bigquery-public-data
SOURCE_DATASET=thelook_ecommerce
SOURCE_LOCATION=US

# Airflow env
AIRFLOW_USER=
AIRFLOW_PASSWORD=

# Airflow configs
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120

# Airflow DB env
# To merge with postgres env
AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://$AIRFLOW_DB_USER:$AIRFLOW_DB_PASSWORD@postgres:5432/$AIRFLOW_DB_NAME

# Path to Google Service account key in the container
GOOGLE_APPLICATION_CREDENTIALS="/app/airflow/keys/gcp-service-account.json"

# Airflow secrets
# Randomly generated with: poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Randomly generated with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Randomly generated with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW__API__SECRET_KEY=
