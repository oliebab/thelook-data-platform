# The look dataset
SOURCE_PROJECT=bigquery-public-data
SOURCE_DATASET=thelook_ecommerce
SOURCE_LOCATION=US

# Big Query dataset
DESTINATION_DATASET=

# Airflow env
AIRFLOW_USER=
AIRFLOW_PASSWORD=

# Airflow DB env
AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://$AIRFLOW_DB_USER:$AIRFLOW_DB_PASSWORD@postgres:5432/$AIRFLOW_DB_NAME

# Airflow secrets
# Randomly generated with: poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Randomly generated with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Randomly generated with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW__API__SECRET_KEY=
